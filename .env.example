# Copie para .env e preencha. O .env real NÃO deve ser versionado.

# Usados pelo container do Postgres (docker-compose.yml)
POSTGRES_DB=order_db
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me

# Usados pela aplicação Spring Boot (application-dev.properties)
DB_URL=jdbc:postgresql://localhost:5433/order_db
DB_USER=change-me
DB_PASSWORD=change-me
